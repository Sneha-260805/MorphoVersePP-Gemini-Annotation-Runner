# Copy this file to .env (gitignored) or export these as real environment
# variables. NONE of the values below are secrets — they are safe,
# non-sensitive configuration. Do not put an API key, access token, refresh
# token, or service-account path in this file or in .env.
#
# Authentication itself is NOT an environment variable in this project: each
# teammate runs `gcloud auth application-default login` locally and Vertex
# uses Application Default Credentials / IAM. See TEAMMATE_SETUP.md.

GOOGLE_CLOUD_PROJECT=morphoverse-pilot
GOOGLE_CLOUD_LOCATION=global
VERTEX_GEMINI_MODEL=gemini-3.5-flash
